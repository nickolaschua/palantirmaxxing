# Free account at https://ion.cesium.com — needed for terrain + OSM Buildings fallback.
# Cesium's bundled default token is release-scoped and gets revoked; do not rely on it.
VITE_CESIUM_ION_TOKEN=

# Google Cloud project with the Map Tiles API enabled and billing on.
# Leave blank to run the free OSM-extrusion fallback.
VITE_GOOGLE_MAPS_API_KEY=
