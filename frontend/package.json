{
  "name": "singapore-canvas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:lib": "tsc --noEmit && vite build --config vite.lib.config.ts",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test ../tests/unit/population-model.test.ts ../tests/unit/decision-model.test.ts ../tests/unit/interceptor-model.test.ts ../tests/unit/ground-model.test.ts ../tests/unit/simulation-model.test.ts ../tests/unit/scenario-manifest-model.test.ts ./tests/delivery.test.ts",
    "test:ui": "vitest run --config vitest.config.ts",
    "test:demo": "node tests/demo-rehearsal.mjs"
  },
  "dependencies": {
    "cesium": "^1.145.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-cesium": "^1.2.23",
    "vitest": "^5.0.2"
  }
}
