  "validation": {
    "seed_start_inclusive": 10000,
    "seed_end_exclusive": 10064,
    "episode_count": 64
  },
  "held_out_test": {
    "seed_start_inclusive": 20000,
    "seed_end_exclusive": 20256,
    "episode_count": 256
  },
  "stress": {
    "seed_start_inclusive": 30000,
    "seed_end_exclusive": 30032,
    "episode_count": 32,
    "threats_per_episode": 8,
    "interceptors_per_episode": 8,
    "candidates_per_pair": 20
  },
  "bounded_oracle": {
    "seed_start_inclusive": 40000,
    "seed_end_exclusive": 40032,
    "episode_count": 32,
    "maximum_threats": 3,
    "maximum_interceptors": 3,
    "candidates_per_pair": 5,
